{
  "name": "@blackblend/studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --mode standalone",
    "build": "vite build --mode standalone && node scripts/normalize-build.mjs",
    "preview": "wrangler dev --config dist/server/wrangler.json --compatibility-date 2026-05-15 --local --ip 127.0.0.1 --port 4331 --inspector-port 0",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply blackblend-studio --local --config wrangler.jsonc"
  },
  "dependencies": {
    "@clerk/react": "6.17.8",
    "@openai/agents-core": "0.21.0",
    "@openai/agents-openai": "0.21.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.13",
    "lucide-react": "1.31.0",
    "mediabunny": "1.62.0",
    "next": "16.4.2",
    "openai": "7.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.6.0",
    "tailwind-merge": "3.7.0",
    "three": "0.179.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.3.5",
    "wrangler": "4.151.0"
  },
  "type": "module"
}
