{
  "name": "blackblend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @blackblend/studio",
    "build": "npm run build --workspace @blackblend/studio",
    "preview": "npm run preview --workspace @blackblend/studio",
    "start:desktop": "node server.mjs",
    "video": "node tt-video.mjs",
    "agent:key": "node scripts/agent-key.mjs",
    "typecheck": "npm run typecheck --workspace @blackblend/studio",
    "test": "node --test tests/*.test.mjs && npm run test --workspace @blackblend/studio",
    "test:desktop": "node --test tests/*.test.mjs",
    "test:studio": "npm run test --workspace @blackblend/studio",
    "check:dependencies": "node scripts/audit-dependencies.mjs",
    "deploy": "npm run deploy --workspace @blackblend/studio",
    "db:local": "npm run db:local --workspace @blackblend/studio"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1"
  },
  "workspaces": [
    "apps/studio",
    "vendor/*"
  ],
  "devDependencies": {
    "braces": "file:vendor/braces"
  },
  "overrides": {
    "fflate": "0.8.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "miniflare": {
      "sharp": "0.35.5"
    },
    "image-size": "2.0.4",
    "esbuild": "0.28.2",
    "undici": "7.30.1"
  },
  "version": "0.1.0",
  "packageManager": "npm@11.21.1"
}
